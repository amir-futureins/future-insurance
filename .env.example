# Copy to .env.local and fill in real values.

# Google Tag Manager container id. When empty, the GTM snippet is not injected
# but conversion events still queue safely on window.dataLayer.
NEXT_PUBLIC_GTM_ID=

# WhatsApp number for the floating CTA (international format, digits only).
NEXT_PUBLIC_WHATSAPP_PHONE=972501234567

# Affiliate deep-links used by /api/go/[provider]. Leave blank to fall back to
# the provider's verified public portal (with our UTM tags). When you set a real
# partner URL here, the handler redirects to it as-is (no UTM clobbering).
AFFILIATE_PASSPORTCARD=
AFFILIATE_HAREL=
AFFILIATE_MIGDAL=
AFFILIATE_CLAL=

# --- Lead routing (/api/leads) — every channel is optional & best-effort ---
# 1) Admin e-mail via Resend (https://resend.com). Without a key, e-mail is skipped.
#    RESEND_API_KEY must be a server secret. LEADS_FROM_EMAIL must be a domain you
#    verified in Resend. LEADS_TO_EMAIL defaults to amir@il-ins.co.il.
RESEND_API_KEY=
LEADS_FROM_EMAIL=Future Insurance <leads@futureins.co.il>
# Admin recipient for lead alerts. ADMIN_EMAIL takes precedence over LEADS_TO_EMAIL.
ADMIN_EMAIL=amir@il-ins.co.il
LEADS_TO_EMAIL=amir@il-ins.co.il

# 2) Google Sheets — a Google Apps Script Web-App URL that appends a row per lead.
GOOGLE_SHEETS_WEBHOOK_URL=

# 3) Optional generic webhook (CRM upsert / server-side CAPI).
LEADS_WEBHOOK_URL=
